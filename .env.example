# ==========================================
# EduCheck AI - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your actual values

# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/educheck
DATABASE_ECHO=False

# AUTH SERVICE
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=8000
AUTH_SERVICE_URL=http://localhost:8000

# EXAM SERVICE
EXAM_SERVICE_HOST=localhost
EXAM_SERVICE_PORT=8002
EXAM_SERVICE_URL=http://localhost:8002

# OCR SERVICE
OCR_SERVICE_HOST=localhost
OCR_SERVICE_PORT=8003
OCR_SERVICE_URL=http://localhost:8003

# GROQ API (for OCR)
GROQ_API_KEY=your_groq_api_key_here

# PDFLATEX PATH (for PDF generation)
PDFLATEX_PATH=/usr/bin/pdflatex

# FRONTEND URLs (for CORS)
FRONTEND_AUTH_URL=http://localhost:3000
FRONTEND_EXAM_URL=http://localhost:3001

# JWT SETTINGS
JWT_SECRET_KEY=your_super_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ENVIRONMENT
ENVIRONMENT=development
DEBUG=False
